# Copie este arquivo para ".env" e preencha com os valores do seu ambiente.
# NUNCA versione o arquivo ".env" (ele contém a senha do banco).

# Chave usada pelo Flask para assinar a sessão. Gere uma string aleatória.
SECRET_KEY=troque-por-uma-chave-aleatoria

# PostgreSQL local (gerenciado via pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbis_health
DB_USER=postgres
DB_PASSWORD=

# Regras de bloqueio de login (HU-001, cenário 3)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Geocodificação e rotas (OpenStreetMap). Servidores públicos por padrão —
# sem chave de API, mas com política de uso justo (poucas req/s). Troque
# pelas suas próprias instâncias em produção se o volume crescer.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
MAPS_USER_AGENT=OrbisHealth-UCB/1.0

# ---------------------------------------------------------------- servidor
# Endereço e porta em que o servidor escuta. 127.0.0.1 = só este computador;
# 0.0.0.0 = visível na rede local (outros computadores, celular, app mobile).
HOST=127.0.0.1
PORT=5000

# 1 SOMENTE quando houver um proxy reverso com HTTPS na frente (Caddy, nginx,
# Cloudflare Tunnel, ngrok...). Sem isto, o login via https:// é recusado.
ATRAS_DE_PROXY=0

# Modo debug (recarrega ao editar). Nunca ligue num servidor acessível por
# outras pessoas: ele expõe um console que executa código no servidor.
FLASK_DEBUG=0

# Fuso da operação (o banco guarda UTC)
FUSO_HORARIO=America/Sao_Paulo

# 1 = modo demonstração (apresentação do TCC): libera /demo, onde qualquer
# pessoa entra como socorrista sem cadastro (conta temporária, apagada em
# 24 h; sem envio de fotos; trajeto curto; hospital responde sozinho no
# chat). O QR code para projetar fica em /demo/qrcode (login de admin).
MODO_DEMONSTRACAO=0
